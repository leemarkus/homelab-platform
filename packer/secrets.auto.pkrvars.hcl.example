# Copy to secrets.auto.pkrvars.hcl (gitignored) and fill in.
# Packer loads every *.auto.pkrvars.hcl in this directory automatically — no
# -var-file flag and no exported PKR_VAR_* needed.
#
# The Proxmox token should be scoped to the hypervisor you are building on, and
# should NOT be the same token tofu uses: separate credentials mean a leak of
# either is contained to one tool.
proxmox_api_token = "root@pam!packer=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Build-time only. The installer inside the ephemeral VM uses it so Packer can
# SSH in; the cleanup provisioner runs `passwd -d kube` before the VM becomes a
# template, and the hardening role disables password auth entirely. It does not
# survive into any node.
ssh_password = "changeme-throwaway"
